# Copiá este archivo como ".env.local" y pegá los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API / o el botón "Connect" → framework Vue).
# En Vue CLI las variables tienen que empezar con VUE_APP_ para poder usarse en el código.
VUE_APP_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VUE_APP_SUPABASE_ANON_KEY=tu-anon-public-key
